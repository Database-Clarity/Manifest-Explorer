/index.html
  Cache-Control: no-cache, no-store, must-revalidate
/
  Cache-Control: no-cache, no-store, must-revalidate
/version.json
  Cache-Control: no-cache, no-store, must-revalidate
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/favicon-dark.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon-light.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/oembed.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/og-image.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/og-history.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
